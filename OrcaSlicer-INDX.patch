+std::vector<LibraryEntry> library_entries(const Json& library,const Json& assignments) {
+    std::vector<LibraryEntry> entries;
+    if(library.empty())return entries;
+    if(library.value("schema",0)!=3 || !library.contains("profiles") || !library.at("profiles").is_object() || library.at("profiles").size()>1000)
+        throw std::runtime_error(_u8L("Libreria filamenti non valida o troppo grande."));
+    auto& bundle=*wxGetApp().preset_bundle;
+    const auto* sizes=bundle.printers.get_edited_preset().config.option<ConfigOptionFloats>("nozzle_diameter");
+    for(auto item=library.at("profiles").begin();item!=library.at("profiles").end();++item){
+        const auto& a=item.value();const auto uuid=item.key();
+        if(uuid.size()!=32 || !std::all_of(uuid.begin(),uuid.end(),[](char c){return(c>='0'&&c<='9')||(c>='a'&&c<='f');}))throw std::runtime_error(_u8L("Identita filamento non valida."));
+        const auto profile=a.at("profile_id").get<std::string>();
+        const Preset* source=bundle.filaments.find_preset(profile,false);
+        if(!source || !source->is_compatible)throw std::runtime_error("Base Orca assente o incompatibile: "+profile);
+        const auto physical_name=a.at("name").get<std::string>();
+        if(physical_name.empty() || physical_name.size()>640)throw std::runtime_error(_u8L("Nome filamento non valido."));
+        const auto color=a.value("color",std::string("#FFFFFF"));
+        if(color.size()!=7 || color[0]!='#' || !std::all_of(color.begin()+1,color.end(),[](char c){return(c>='0'&&c<='9')||(c>='A'&&c<='F')||(c>='a'&&c<='f');}))throw std::runtime_error(_u8L("Colore filamento non valido."));
+        const auto calibrations=a.value("calibrations",Json::object());
+        const auto variants=a.value("calibration_variants",Json::object());
+        std::set<int> tools;
+        for(int t=0;t<int(tool_count());++t){auto key=std::to_string(t);
+            if(calibrations.contains(key))tools.insert(t);
+            if(a.value("tool_settings",Json::object()).contains(key))tools.insert(t);
+            for(auto v=variants.begin();v!=variants.end();++v)if(v.key().rfind(key+":",0)==0)tools.insert(t);
+            if(assignments.contains(key) && assignments.at(key).value("library_id",std::string())==uuid)tools.insert(t);
+        }
+        if(tools.empty())tools.insert(0);
+        for(int t:tools){
+            const auto key=std::to_string(t);const auto nozzle=nozzle_setup()[t];const auto signature=nozzle_key(t,nozzle);
+            Json cal=a.value("calibration_variants",Json::object()).value(signature,Json::object());
+            if(cal.empty()){
+                const auto legacy=calibrations.value(key,Json::object());
+                if(std::abs(legacy.value("nozzle",0.)-sizes->values[t])<.0001 && legacy.value("nozzle_type",std::string("standard"))==nozzle.at("type"))cal=legacy;
+            }
+            DynamicPrintConfig config=source->config;
+            const int temp=a.at("temp").get<int>(),bed=a.at("bed").get<int>();
+            Json settings=a.value("settings_variants",Json::object()).value(signature,Json::object());
+            static const double original_diameters[]={.4,.4,.6,.8};
+            if(settings.empty() && t<4 && nozzle.at("type")=="standard" && std::abs(sizes->values[t]-original_diameters[t])<.0001)settings=a.value("tool_settings",Json::object()).value(key,Json::object());
+            const auto states=Indx::calibration_states(a,cal,settings);
+            for(const std::string kind:{"pa","flow","max_flow"})
+                if(states.at(kind).at("state")!="verified")cal.erase(kind);
+            const double flow=cal.value("flow",settings.value("flow",a.value("flow",1.)));
