+            const auto& a=result.assignments.at(key);
+            if(a.contains("library_id") && !result.library.empty())continue;
+            if(std::abs(a.value("nozzle",0.)-sizes->values[t])>0.0001)throw std::runtime_error("Diametro T"+key+" diverso tra touchscreen e profilo stampante.");
+            if(!a.contains("profile_id"))throw std::runtime_error("T"+key+": scegli un profilo Orca dalla nuova pagina Filamenti per testa e salva l'assegnazione.");
+            const auto profile=a.at("profile_id").get<std::string>();
+            const Preset* source=bundle.filaments.find_preset(profile,false);
+            if(!source)throw std::runtime_error("Profilo non piu presente in Orca: "+profile);
+            if(!source->is_compatible)throw std::runtime_error("Profilo non compatibile con INDX: "+profile+". Crea una copia compatibile in Orca, poi sincronizza il catalogo.");
+            DynamicPrintConfig config=source->config;
+            auto catalog_entry=std::find_if(data["profiles"].begin(),data["profiles"].end(),[&](const Json& p){return p.at("id")==profile;});
+            const std::string current_revision=catalog_entry==data["profiles"].end()?std::string():catalog_entry->at("revision").get<std::string>();
+            const auto name=a.at("name").get<std::string>();
+            std::string summary="T"+key+": "+name+" (PA del profilo)";
+            auto pa_key=name+"|T"+key;
+            if(result.pa.is_object() && result.pa.contains(pa_key)){
+                const auto& calibration=result.pa.at(pa_key);
+                if(calibration.value("base",std::string())=="orca:"+profile &&
+                    calibration.value("profile_revision",std::string())==current_revision &&
+                    std::abs(calibration.value("nozzle",0.)-sizes->values[t])<0.0001 && calibration.contains("pa")){
+                    const double value=calibration.at("pa").get<double>();
+                    if(!std::isfinite(value)||value<0||value>1)throw std::runtime_error("PA non valido per T"+key);
+                    auto* old=config.option<ConfigOptionFloats>("pressure_advance");size_t n=old?old->values.size():1;
+                    config.set_key_value("pressure_advance",new ConfigOptionFloats(std::vector<double>(std::max(size_t(1),n),value)));
+                    config.set_key_value("enable_pressure_advance",new ConfigOptionBools(std::vector<unsigned char>(std::max(size_t(1),n),1)));
+                    // An explicit measured PA is the selected calibration for this copy.
+                    if(config.has("adaptive_pressure_advance"))config.set_deserialize_strict("adaptive_pressure_advance","0");
+                    summary="T"+key+": "+name+" - PA INDX "+std::to_string(value);
+                }
+            }
+            for(auto field:{"nozzle_temperature","nozzle_temperature_initial_layer"})
+                if(a.contains("temp"))config.set_key_value(field,new ConfigOptionInts({a.at("temp").get<int>()}));
+            const int temp=a.value("temp",210),bed=a.value("bed",60);
+            if(temp<170 || temp>340 || bed<0 || bed>110)throw std::runtime_error("Temperature fuori intervallo per T"+key);
+            for(auto field:{"hot_plate_temp","hot_plate_temp_initial_layer","textured_plate_temp","textured_plate_temp_initial_layer"})
+                config.set_key_value(field,new ConfigOptionInts({bed}));
+            if(a.contains("brand"))config.set_key_value("filament_vendor",new ConfigOptionStrings({a.at("brand").get<std::string>()}));
+            const auto color=a.value("color",std::string("#FFFFFF"));
+            if(color.size()!=7 || color[0]!='#' || !std::all_of(color.begin()+1,color.end(),[](char c){return(c>='0'&&c<='9')||(c>='A'&&c<='F')||(c>='a'&&c<='f');}))throw std::runtime_error("Colore non valido per T"+key);
+            std::ostringstream identity;config.save_to_json(identity,name,"User","2.5.0");
+            entries.push_back({t,"INDX T"+key+" - "+name+" ["+digest(identity.str())+"]",source->filament_id,color,std::move(config),summary,true});
+        }
+        if(entries.empty()){
+            wxMessageBox(wxString::Format("Pubblicati %zu profili. Su KlipperScreen premi Sincronizza profili, poi assegna i filamenti a T0-T3.",data["profiles"].size()),"INDX",wxOK|wxICON_INFORMATION,parent);return;
+        }
+        wxString overview;
+        for(const auto& e:entries)if(e.assigned)overview+=wxString::FromUTF8(e.summary)+"\n";
+        if(wxMessageBox(_L("Salvare la libreria personale e applicare queste assegnazioni?\n\n")+overview,_L("Sincronizza INDX"),wxYES_NO|wxICON_QUESTION,parent)!=wxYES)return;
+        wxGetApp().plater()->take_snapshot("Sincronizza filamenti INDX");
+        std::vector<LibraryEntry> saved_entries;
+        for(const auto& e:entries)if(e.id.rfind("INDX:",0)==0)saved_entries.push_back(e);
+        persist_library(saved_entries);
+        bundle.set_num_filaments(4);
+        auto* colors=bundle.project_config.option<ConfigOptionStrings>("filament_colour",true);
+        colors->values.resize(4,"#FFFFFF");
+        for(auto& e:entries){
+            if(!e.assigned)continue;
+            const auto existing=bundle.filaments.find_preset(e.name,false);
+            const auto actual=existing?existing->name:bundle.filaments.add_detached_preset(e.name,std::move(e.config),e.id);
+            bundle.filament_presets[e.tool]=actual;colors->values[e.tool]=e.color;
+            auto* multi=bundle.project_config.option<ConfigOptionStrings>("filament_multi_colour",true);
+            auto* types=bundle.project_config.option<ConfigOptionStrings>("filament_colour_type",true);
+            auto* mixed=bundle.project_config.option<ConfigOptionBools>("filament_is_mixed",true);
+            multi->values.resize(4);types->values.resize(4,"1");mixed->values.resize(4,0);
+            multi->values[e.tool]=e.color;types->values[e.tool]="1";mixed->values[e.tool]=0;
+        }
+        bundle.project_config.set_key_value("filament_map",new ConfigOptionInts({1,2,3,4}));
+        bundle.project_config.set_deserialize_strict("filament_map_mode","Manual");
+        auto& plates=wxGetApp().plater()->get_partplate_list();
+        for(int i=0;i<plates.get_plate_count();++i){auto* plate=plates.get_plate(i);if(plate){plate->set_filament_maps({1,2,3,4});plate->set_filament_map_mode(fmmManual);}}
+        wxGetApp().plater()->on_filament_count_change(4);
+        wxGetApp().get_tab(Preset::TYPE_FILAMENT)->select_preset(bundle.filament_presets[0]);
+        wxGetApp().load_current_presets(false,false);
+        wxGetApp().plater()->sidebar().update_all_preset_comboboxes();
+        wxGetApp().plater()->update_filament_colors_in_full_config();
+        bundle.export_selections(*wxGetApp().app_config);
+        wxMessageBox(_L("Libreria personale salvata: colore, temperature, PA, flow e flusso massimo. Assegnazioni applicate. Salva il progetto e rislicera prima di stampare."),"INDX",wxOK|wxICON_INFORMATION,parent);
+    }catch(const std::exception& e){wxMessageBox(wxString::FromUTF8(e.what()),_L("Sincronizza INDX"),wxOK|wxICON_ERROR,parent);}
+}
+} }
