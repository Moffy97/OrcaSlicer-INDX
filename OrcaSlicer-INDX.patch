+    for(int t=0;t<4;++t)tools.push_back({{"filament",t+1},{"tool",t},{"diameter",diameters[t]},{"material","PLA"}});
+    const auto detail=propose_roles(tools,"detail",tools),balanced=propose_roles(tools,"balanced",tools);
