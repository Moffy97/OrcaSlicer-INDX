+TEST_CASE("Calibration validity follows the saved test conditions", "[IndxChecks]")
+{
+    auto r=record();auto context=r;context.erase("flow");context["flow"]=.97;
+    Json cal={{"flow",.97},{"pa",.04},{"max_flow",18.}};
+    for(const std::string kind:{"flow","pa","max_flow"})
+        cal[kind+"_test"]={{"method","visual-manual"},{"updated",100.},{"context",context}};
+    auto states=calibration_states(r,cal,Json::object());
+    for(const std::string kind:{"flow","pa","max_flow"})CHECK(states[kind]["state"]=="verified");
+    r["name"]="Renamed";r["color"]="#000000";
+    CHECK(calibration_states(r,cal,Json::object())["pa"]["state"]=="verified");
+    r["temp"]=220;
+    for(const std::string kind:{"flow","pa","max_flow"})CHECK(calibration_states(r,cal,Json::object())[kind]["state"]=="stale");
+}
