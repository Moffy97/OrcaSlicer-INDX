+void persist_library(const std::vector<LibraryEntry>& entries){
+    auto& collection=wxGetApp().preset_bundle->filaments;
+    const auto selected_name=collection.get_edited_preset().name;
+    std::vector<Preset> copies;copies.reserve(entries.size());
+    auto mapping_raw=wxGetApp().app_config->get("indx_generated_sources");
+    Json mapping=mapping_raw.empty()?Json::object():Json::parse(mapping_raw);
+    for(const auto& e:entries){
+        if(!e.source.empty())mapping[e.name]=e.source;
+        const auto* existing=collection.find_preset(e.name,false);
+        if(existing && (existing->filament_id!=e.id || !existing->can_overwrite()))throw std::runtime_error("Nome profilo gia usato: "+e.name);
+        if(existing && existing->config==e.config)continue;
+        copies.emplace_back(Preset::TYPE_FILAMENT,e.name,false);auto& p=copies.back();
+        p.config=e.config;p.filament_id=e.id;p.is_compatible=true;p.loaded=true;p.version=Semver(2,5,0);
+        p.config.option<ConfigOptionStrings>("filament_settings_id",true)->values={e.name};
+    }
+    wxGetApp().app_config->set("indx_generated_sources",mapping.dump());
+    if(copies.empty())return;
+    std::vector<const Preset*> pointers;for(const auto& p:copies)pointers.push_back(&p);
+    std::vector<std::string> failures;
+    if(!collection.clone_presets(pointers,failures,[](Preset&,Preset::Type&){},true))throw std::runtime_error(_u8L("Salvataggio libreria Orca fallito."));
+    // Replace only older generated names with the same stable identity (rename).
+    std::vector<std::string> obsolete;
+    for(const auto& p:collection)for(const auto& e:entries)
+        if(p.filament_id==e.id && p.name!=e.name && p.name.rfind("INDX T",0)==0 && p.can_overwrite())obsolete.push_back(p.name);
+    for(const auto& old:obsolete){
+        // Keep profiles referenced by the open project until its explicit sync.
+        const auto& active=wxGetApp().preset_bundle->filament_presets;
+        if(old!=selected_name && std::find(active.begin(),active.end(),old)==active.end())collection.delete_preset(old);
+    }
+    if(!obsolete.empty())collection.select_preset_by_name(selected_name,true);
+}
