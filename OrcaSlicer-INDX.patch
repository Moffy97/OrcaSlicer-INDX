+TEST_CASE("Legacy numbers and changed flow do not become verified results", "[IndxChecks]")
+{
+    auto r=record();Json cal={{"pa",.04}};
+    CHECK(calibration_states(r,cal,Json::object())["pa"]["state"]=="stale");
+    auto context=r;context["flow"]=.95;
+    cal["pa_test"]={{"method","visual-manual"},{"updated",100.},{"context",context}};
+    CHECK(calibration_states(r,cal,Json::object())["pa"]["state"]=="stale");
+    CHECK(calibration_states(r,Json::object(),Json::object())["max_flow"]["state"]=="estimated");
+}
