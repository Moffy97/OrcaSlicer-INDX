+struct Publisher {
+    wxTimer timer;
+    std::future<NetworkResult> pending;
+    std::string last_hash,pending_hash,last_library_hash;
+    std::chrono::steady_clock::time_point next;
+    explicit Publisher(wxWindow* owner,int id):timer(owner,id){}
+    void tick() {
+        if (pending.valid()) {
+            if (pending.wait_for(std::chrono::seconds(0))!=std::future_status::ready) return;
+            auto result=pending.get();
+            if(result.error.empty()) {
+                last_hash=result.fingerprint;
+                if(!result.library.empty())wxGetApp().app_config->set("indx_library_cache",result.library.dump());
+                if(is_indx_printer() && !result.library.empty() && !wxGetApp().preset_bundle->filaments.get_edited_preset().is_dirty){
+                    const auto signature=digest(result.library.dump());
+                    if(signature!=last_library_hash){
+                        auto entries=library_entries(result.library,Json::object());persist_library(entries);
+                        wxGetApp().plater()->sidebar().update_all_preset_comboboxes();last_library_hash=signature;
+                    }
+                }
+            }
+            else next=std::chrono::steady_clock::now()+std::chrono::seconds(30);
+        }
+        if(!is_indx_printer() || std::chrono::steady_clock::now()<next) return;
+        next=std::chrono::steady_clock::now()+std::chrono::seconds(15);
+        auto data=catalog_snapshot();auto fingerprint=data;fingerprint.erase("generated_at");
+        pending_hash=digest(fingerprint.dump());
+        auto url=host_url();auto previous=last_hash;
+        pending=std::async(std::launch::async,[url,previous,data=std::move(data)](){return transfer(url,data,false,previous);});
+    }
+};
+}
