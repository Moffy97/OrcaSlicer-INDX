+bool apply_nozzle_setup(const Json& next) {
+    const auto previous=nozzle_setup();
+    const size_t count=next.size();
+    std::set<int> changed;
+        auto& bundle=*wxGetApp().preset_bundle;Preset printer=bundle.printers.get_edited_preset();
+        printer.set_num_extruders(unsigned(count));
+        auto* sizes=printer.config.option<ConfigOptionFloats>("nozzle_diameter");
+        for(int t=0;t<int(count);++t){
+            const auto& n=next.at(t);
+            if(size_t(t)>=previous.size() || n!=previous[t])changed.insert(t);sizes->values[t]=n.at("diameter").get<double>();
+            if(auto* max=printer.config.option<ConfigOptionFloats>("max_layer_height")){if(max->values.size()>size_t(t))max->values[t]=sizes->values[t]*.7;}
+            if(auto* min=printer.config.option<ConfigOptionFloats>("min_layer_height")){if(min->values.size()>size_t(t))min->values[t]=sizes->values[t]*.1;}
+        }
+        if(changed.empty() && count==previous.size())return false;
+        wxGetApp().plater()->take_snapshot("Ugelli INDX");
+        const std::string printer_name=printer.can_overwrite()?printer.name:printer.name+" - Ugelli personali";
+        const auto folder=boost::filesystem::path(data_dir())/"indx-profile-backups";
+        boost::filesystem::create_directories(folder);
+        const auto stamp=std::chrono::system_clock::now().time_since_epoch().count();
+        boost::nowide::ofstream backup((folder/(std::to_string(stamp)+"-printer.json")).string());
+        bundle.printers.get_edited_preset().config.save_to_json(backup,printer.name,"User","2.5.0");
+        if(!backup)throw std::runtime_error(_u8L("Backup stampante fallito: sincronizzazione ugelli interrotta."));
+        backup.close();
+        bundle.printers.save_current_preset(printer_name,false,false,&printer);
+        wxGetApp().app_config->set("indx_nozzle_setup",next.dump());
+        const auto setups_raw=wxGetApp().app_config->get("indx_nozzle_setups");
+        auto setups=setups_raw.empty()?Json::object():Json::parse(setups_raw);
+        setups[printer_name]=next;wxGetApp().app_config->set("indx_nozzle_setups",setups.dump());
+        bundle.set_num_filaments(std::max(count,bundle.filament_presets.size()));
+        // The background apply resolves current plate assignments before adapting Z.
+        auto raw=wxGetApp().app_config->get("indx_generated_sources");Json mapping=raw.empty()?Json::object():Json::parse(raw);
+        Json assignments=Json::object();
+        for(int t=0;t<int(tool_count());++t){const auto* active=bundle.filaments.find_preset(bundle.filament_presets[t],false);
+            if(active && active->filament_id.rfind("INDX:",0)==0 && active->filament_id.size()>37 && active->filament_id[37]==':')assignments[std::to_string(t)]={{"library_id",active->filament_id.substr(5,32)}};
+        }
+        raw=wxGetApp().app_config->get("indx_library_cache");Json library=raw.empty()?Json::object():Json::parse(raw);
+        auto entries=library_entries(library,assignments);
+        for(int t:changed){
+            if(assignments.contains(std::to_string(t)))continue;
+            const auto active_name=bundle.filament_presets[t];const auto source_name=mapping.value(active_name,active_name);
+            const Preset* source=bundle.filaments.find_preset(source_name,false);
+            if(!source)continue;
+            const bool generic=source_name.rfind("Generic ",0)==0 || source_name.find("Base da calibrare")!=std::string::npos;
+            auto config=source->config;const auto* speed=config.option<ConfigOptionFloats>("filament_max_volumetric_speed");
+            const double base=speed && !speed->values.empty() && speed->values[0]>0?speed->values[0]:8.;
+            const double estimate=generic?base*(next[t].at("type")=="cht"?next[t].at("cht_multiplier").get<double>():1.):std::min(base,8.);
+            config.set_key_value("filament_max_volumetric_speed",new ConfigOptionFloats({std::min(100.,estimate)}));
+            config.set_deserialize_strict("enable_pressure_advance","0");
+            if(config.has("adaptive_pressure_advance"))config.set_deserialize_strict("adaptive_pressure_advance","0");
+            config.set_key_value("compatible_printers",new ConfigOptionStrings({printer_name}));config.set_deserialize_strict("compatible_printers_condition","");
+            std::string label=wxString::FromUTF8(source_name).Left(32).ToUTF8().data();for(char& c:label)if(std::string("<>:\"/\\|?*").find(c)!=std::string::npos)c='_';
+            const auto hw=nozzle_key(t,next[t]);
+            const auto name="INDX T"+std::to_string(t)+" - "+label+" "+std::to_string(int(std::round(sizes->values[t]*1000)))+" "+next[t].at("type").get<std::string>()+" stimato";
+            entries.push_back({t,name,"INDX:generic:"+digest(source_name+hw),"#FFFFFF",std::move(config),"",true,source_name});
+        }
+        persist_library(entries);
+        for(const auto& entry:entries)if(entry.assigned && changed.count(entry.tool))bundle.filament_presets[entry.tool]=entry.name;
+        wxGetApp().get_tab(Preset::TYPE_FILAMENT)->select_preset(bundle.filament_presets[0]);
+        wxGetApp().load_current_presets(false,false);wxGetApp().plater()->on_filament_count_change(bundle.filament_presets.size());
+        wxGetApp().plater()->sidebar().update_all_preset_comboboxes();bundle.export_selections(*wxGetApp().app_config);
+        wxGetApp().app_config->save();
+    return true;
+}
