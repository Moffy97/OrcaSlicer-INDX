+TEST_CASE("Detail proposals never substitute a coarse nozzle for an unavailable fine tool", "[IndxChecks]") {
+    const auto candidate=[](int filament,int tool,double d){return Json{{"filament",filament},{"tool",tool},{"diameter",d},{"material","PLA"}};};
+    const Json mounted=Json::array({{{"tool",0},{"diameter",.6}},{{"tool",1},{"diameter",.4}},{{"tool",2},{"diameter",.8}}});
+    const Json mapped=Json::array({candidate(1,0,.6),candidate(2,1,.4),candidate(3,2,.8)});
+    CHECK(propose_roles(mapped,"detail",mounted)["wall"]["tool"]==1);
+    CHECK_THROWS_AS(propose_roles(Json::array({candidate(1,0,.6)}),"detail",mounted),std::invalid_argument);
+    CHECK(propose_roles(mapped,"balanced",mounted)["wall"]["tool"]==0);
+    CHECK(propose_roles(mapped,"detail",mounted)["solid"]["tool"]==1);
+    CHECK(propose_roles(mapped,"detail",mounted)["infill"]["tool"]==2);
+    CHECK(propose_roles(mapped,"balanced",mounted)["infill"]["tool"]==2);
+    CHECK_THROWS_AS(propose_roles(Json::array({candidate(1,0,.6)}),"detail"),std::invalid_argument);
+    auto finer=mounted;finer.push_back({{"tool",3},{"diameter",.2}});
+    CHECK_THROWS_AS(propose_roles(mapped,"detail",finer),std::invalid_argument);
+    auto all=mapped;all.push_back(candidate(4,3,.2));
+    CHECK(propose_roles(all,"detail",finer)["wall"]["tool"]==3);
+}
