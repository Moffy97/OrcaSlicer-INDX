+Json nozzle_setup() {
+    const auto& printer=wxGetApp().preset_bundle->printers.get_edited_preset();
+    const auto* sizes=printer.config.option<ConfigOptionFloats>("nozzle_diameter");
+    Json saved=Json::array();
+    const auto all_raw=wxGetApp().app_config->get("indx_nozzle_setups");
+    auto all=all_raw.empty()?Json::object():Json::parse(all_raw);
+    if(all.contains(printer.name))saved=all.at(printer.name);
+    else if(all.empty()) {
+        const auto raw=wxGetApp().app_config->get("indx_nozzle_setup");
+        if(!raw.empty()){saved=Json::parse(raw);all[printer.name]=saved;wxGetApp().app_config->set("indx_nozzle_setups",all.dump());}
+    }
+    Json tools=Json::array();
+    for(int t=0;t<int(tool_count());++t){
+        const auto old=saved.is_array() && saved.size()>size_t(t)?saved[t]:Json::object();
+        tools.push_back({{"tool",t},{"diameter",sizes && sizes->values.size()>size_t(t)?sizes->values[t]:.4},
+            {"type",old.value("type",std::string("standard"))},{"cht_multiplier",old.value("cht_multiplier",1.3)}});
+    }
+    return tools;
+}
+std::string nozzle_key(int tool,const Json& nozzle) {
+    // A fixed C-locale representation shared with the touchscreen.
+    std::ostringstream os;os.imbue(std::locale::classic());
+    os<<tool<<":"<<std::fixed<<std::setprecision(3)<<nozzle.at("diameter").get<double>()<<":"<<nozzle.at("type").get<std::string>();
+    return os.str();
+}
+std::string digest(const std::string& s) {
+    boost::uuids::detail::sha1 hash; hash.process_bytes(s.data(),s.size());
+    unsigned int words[5];hash.get_digest(words);
+    std::ostringstream os;os<<std::hex<<std::setfill('0');for(auto word:words)os<<std::setw(8)<<word;return os.str();
+}
+std::string text(const DynamicPrintConfig& c, const char* key) {
+    const auto* opt = c.option(key);
+    if (!opt) return {};
+    if (const auto* values = dynamic_cast<const ConfigOptionStrings*>(opt))
+        return values->values.empty() ? std::string() : values->values.front();
+    return opt->serialize();
+}
