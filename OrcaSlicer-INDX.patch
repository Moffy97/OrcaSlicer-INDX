+// Reuse the plate's region, painted-volume, height-range and support assignments.
+// Installed but unassigned nozzles must not constrain this print.
+std::vector<unsigned int> Print::indx_used_filaments() const
+{
+    std::vector<unsigned int> filaments;
+    for (const PrintObject* object : m_objects) {
+        for (const PrintRegion& region : object->all_regions())
+            region.collect_object_printing_extruders(*this, filaments);
+        for (const ModelVolume* volume : object->model_object()->volumes)
+            if (volume->is_model_part())
+                for (size_t filament : volume->get_extruders_from_multi_material_painting())
+                    filaments.push_back(static_cast<unsigned int>(filament));
+    }
+    // Current-tool supports reuse the object feature tools, rather than adding
+    // an object's default filament when every feature explicitly overrides it.
+    std::vector<unsigned int> supports;
+    for (const PrintObject* object : m_objects)
+        if (object->has_support_material())
+            append_support_extruders(object->config(), unsigned(m_config.filament_diameter.size()), supports);
+    append(filaments, supports);
+    append_tool_change_extruders(filaments);
+    append_wipe_tower_extruder(filaments);
+    sort_remove_duplicates(filaments);
+    return filaments;
+}
+
+double Print::indx_layer_height_limit() const
+{
+    if (m_config.machine_start_gcode.value.find("INDX_PRINT_START") == std::string::npos)
+        return 0.;
+    double cap = 0.;
+    const auto filaments = indx_used_filaments();
+    for (unsigned int filament : filaments) {
+        const size_t tool = get_extruder_index(m_config, filament);
+        if (tool >= m_config.nozzle_diameter.size())
+            continue;
+        const double diameter_limit = 0.7 * m_config.nozzle_diameter.get_at(tool);
+        const double configured = m_config.max_layer_height.get_at(tool);
+        const double limit = configured > 0. ? std::min(configured, diameter_limit) : diameter_limit;
+        cap = cap > 0. ? std::min(cap, limit) : limit;
+    }
+    return cap;
+}
