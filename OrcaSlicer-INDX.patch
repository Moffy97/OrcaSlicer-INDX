+    config.set_key_value("infill_combination_max_layer_height",new ConfigOptionFloatOrPercent(100.,true));
+    config.set_key_value("sparse_infill_filament_id",new ConfigOptionInt(2));
+    config.set_key_value("internal_solid_filament_id",new ConfigOptionInt(1));
