+void install_indx_profile_publisher(wxWindow* owner) {
+    static std::set<wxWindow*> owners;
+    if(!owners.insert(owner).second)return;
+    owner->Bind(wxEVT_DESTROY,[owner](wxWindowDestroyEvent& e){if(e.GetEventObject()==owner)owners.erase(owner);e.Skip();});
+    const int id=wxWindow::NewControlId();auto p=std::make_shared<Publisher>(owner,id);
+    owner->Bind(wxEVT_TIMER,[p](wxTimerEvent&){try{p->tick();}catch(const std::exception& e){BOOST_LOG_TRIVIAL(error)<<"INDX publisher: "<<e.what();}},id);p->timer.Start(5000);
+}
