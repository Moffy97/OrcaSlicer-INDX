+#include <catch2/catch_test_macros.hpp>
+#include <catch2/generators/catch_generators.hpp>
+#include "libslic3r/IndxChecks.hpp"
+using namespace Slic3r::Indx;
+
+TEST_CASE("Automatic hardware import accepts only complete confirmed printer declarations", "[IndxChecks]") {
+    const size_t count=GENERATE(1,2,4,6,8,64);
+    Json tools=Json::array();
+    for(size_t t=0;t<count;++t)tools.push_back({{"tool",t},{"diameter",t%2?.8:.2},{"type",t%2?"cht":"standard"}});
+    Json remote={{"online",true},{"hardware",{{"schema",2},{"confirmed_at",100.},{"tools",tools}}}};
+    const auto imported=confirmed_tools(remote);
+    REQUIRE(imported.size()==count);
+    CHECK(imported.back().at("tool")==count-1);
+    CHECK(imported.front().at("diameter")==.2);
+    CHECK(imported.front().at("cht_multiplier")==1.3);
+    auto offline=remote;offline["online"]=false;CHECK(confirmed_tools(offline).empty());
+    auto unconfirmed=remote;unconfirmed["hardware"].erase("confirmed_at");CHECK(confirmed_tools(unconfirmed).empty());
+    auto bad=remote;bad["hardware"]["tools"][0]["tool"]=1;CHECK_THROWS(confirmed_tools(bad));
+    bad=remote;bad["hardware"]["tools"][0]["diameter"]=0;CHECK_THROWS(confirmed_tools(bad));
+    bad=remote;bad["hardware"]["tools"][0]["type"]="unknown";CHECK_THROWS(confirmed_tools(bad));
+    bad=remote;bad["hardware"]["tools"]=Json::array();CHECK_THROWS(confirmed_tools(bad));
+    bad=remote;bad["hardware"]["tools"]=Json::array();
+    for(size_t t=0;t<65;++t)bad["hardware"]["tools"].push_back({{"tool",t},{"diameter",.4},{"type","standard"}});
+    CHECK_THROWS(confirmed_tools(bad));
+}
+
+TEST_CASE("Combined layer count follows actual Z intervals", "[IndxChecks]") {
+    const std::vector<double> zs={.14,.28,.42,.56,.70,.832};
+    CHECK(combined_layers(zs,3,.56)==4);
+    CHECK(combined_layers(zs,4,.14)==1);
+    CHECK(combined_layers(zs,5,.552)==4);
+    CHECK(combined_layers(zs,0,.56)==0);
+    CHECK(combined_layers(zs,7,.14)==0);
+}
+
+TEST_CASE("Tool proposals preserve filament mapping and reject mixed materials", "[IndxChecks]") {
+    const Json candidates=Json::array({{{"filament",3},{"tool",7},{"diameter",.8},{"material","PLA"}},
+        {{"filament",2},{"tool",0},{"diameter",.2},{"material","PLA"}},
+        {{"filament",1},{"tool",4},{"diameter",.4},{"material","PLA"}}});
+    CHECK(propose_roles(candidates,"balanced")["wall"]["filament"]==1);
+    CHECK(propose_roles(candidates,"balanced")["infill"]["tool"]==7);
+    CHECK(propose_roles(candidates,"detail")["infill"]["tool"]==7);
+    CHECK(propose_roles(candidates,"speed")["wall"]["tool"]==4);
+    auto mixed=candidates;mixed[0]["material"]="PETG";
+    CHECK_THROWS_AS(propose_roles(mixed,"balanced"),std::invalid_argument);
+    CHECK_THROWS_AS(propose_roles(Json::array(),"balanced"),std::invalid_argument);
+}
