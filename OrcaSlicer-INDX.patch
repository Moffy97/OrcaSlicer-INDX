+TEST_CASE("Identical filament slots expose all mounted tools from the default map", "[IndxChecks]") {
+    Json slots=Json::array();for(int t=0;t<4;++t)slots.push_back({{"material","PLA"},{"color","#00FF00"}});
+    const std::vector<int> identity={1,2,3,4},defaults={1,1,1,1},custom={2,1,3,4};
