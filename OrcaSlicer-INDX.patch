+        if(!is_indx_printer())throw std::runtime_error(_u8L("Seleziona la stampante INDX con quattro utensili."));
+        if(!wxGetApp().check_and_save_current_preset_changes(_L("Sincronizza INDX"),"Salva le modifiche ai profili prima della sincronizzazione.",false))return;
