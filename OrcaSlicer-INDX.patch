 using namespace Slic3r;
 
+TEST_CASE("INDX combined infill fills the accumulated wall height with its own nozzle limit", "[Fill][INDX][CombinedInfill]")
+{
+    const double cap=GENERATE(.35,.56,.65);
+    const unsigned expected_layers=cap<.4?1:cap<.6?2:3;
+    auto config=Slic3r::Test::multifilament_config(2);
+    config.set_key_value("machine_start_gcode",new ConfigOptionString("INDX_PRINT_START TOOL=0"));
+    config.set_key_value("nozzle_diameter",new ConfigOptionFloats({.4,.8}));
+    config.set_key_value("max_layer_height",new ConfigOptionFloats({.28,cap}));
+    config.set_key_value("printer_extruder_id",new ConfigOptionInts({1,2}));
+    config.set_key_value("printer_extruder_variant",new ConfigOptionStrings({"Direct Drive Standard","Direct Drive Standard"}));
+    config.set_key_value("filament_map",new ConfigOptionInts({1,2}));
+    config.set_key_value("filament_map_mode",new ConfigOptionEnum<FilamentMapMode>(fmmManual));
+    config.set_key_value("single_extruder_multi_material",new ConfigOptionBool(false));
+    config.set_key_value("layer_height",new ConfigOptionFloat(.2));
+    config.set_key_value("initial_layer_print_height",new ConfigOptionFloat(.2));
+    config.set_key_value("infill_combination",new ConfigOptionBool(true));
+    config.set_key_value("infill_combination_max_layer_height",new ConfigOptionFloatOrPercent(100.,true));
+    config.set_key_value("sparse_infill_filament_id",new ConfigOptionInt(2));
+    config.set_key_value("internal_solid_filament_id",new ConfigOptionInt(1));
+    config.set_key_value("outer_wall_filament_id",new ConfigOptionInt(1));
+    config.set_key_value("inner_wall_filament_id",new ConfigOptionInt(1));
+    config.set_key_value("sparse_infill_density",new ConfigOptionPercent(20));
+    config.set_key_value("sparse_infill_pattern",new ConfigOptionEnum<InfillPattern>(ipRectilinear));
+    Print print;
+    Slic3r::Test::init_and_process_print({Slic3r::Test::cube(12)},print,config);
+    const auto& layers=print.objects().front()->layers();
+    unsigned largest=1;size_t combined=0;
+    for(size_t i=0;i<layers.size();++i){
+        for(const auto* region:layers[i]->regions()){
+            for(const auto& surface:region->fill_surfaces.surfaces){
+                if(surface.surface_type!=stInternal || surface.thickness_layers<=1)continue;
+                ++combined;largest=std::max(largest,unsigned(surface.thickness_layers));
+                double wall_height=0;
+                REQUIRE(i+1>=surface.thickness_layers);
+                for(size_t k=i+1-surface.thickness_layers;k<=i;++k)wall_height+=layers[k]->height;
+                CHECK_THAT(surface.thickness,Catch::Matchers::WithinAbs(wall_height,1e-6));
+                CHECK(surface.thickness<=cap+1e-6);
+                CHECK_THAT(surface.thickness,Catch::Matchers::WithinAbs(surface.thickness_layers*.2,1e-6));
+            }
+            for(const auto* entity:region->perimeters.flatten().entities)
+                if(const auto* path=dynamic_cast<const ExtrusionPath*>(entity))CHECK_THAT(path->height,Catch::Matchers::WithinAbs(layers[i]->height,1e-6));
+        }
+    }
+    CHECK(largest==expected_layers);
+    if(expected_layers>1)CHECK(combined>0);
+    else CHECK(combined==0);
+}
+
+TEST_CASE("INDX layer limits follow used plate tools and their mapping", "[Fill][INDX][UsedLayerTools]")
+{
+    auto config = Slic3r::Test::multifilament_config(2);
+    config.set_key_value("machine_start_gcode", new ConfigOptionString("INDX_PRINT_START"));
+    config.set_key_value("nozzle_diameter", new ConfigOptionFloats({.2, .8}));
+    config.set_key_value("max_layer_height", new ConfigOptionFloats({.14, .56}));
+    config.set_key_value("filament_map", new ConfigOptionInts({1, 2}));
+    config.set_key_value("filament_map_mode", new ConfigOptionEnum<FilamentMapMode>(fmmManual));
+    config.set_key_value("single_extruder_multi_material", new ConfigOptionBool(false));
+    config.set_key_value("enable_support", new ConfigOptionBool(false));
+    Print print;
+    Model model;
+    Slic3r::Test::init_print({Slic3r::Test::cube(12)}, print, model, config);
+    model.objects.front()->config.set_key_value("extruder", new ConfigOptionInt(2));
+    print.apply(model, config);
+    CHECK_THAT(print.indx_layer_height_limit(), Catch::Matchers::WithinAbs(.56, 1e-6));
+
+    // A used small nozzle constrains the shared Z schedule, including supports.
+    config.set_key_value("enable_support", new ConfigOptionBool(true));
+    config.set_key_value("support_filament", new ConfigOptionInt(1));
+    config.set_key_value("support_interface_filament", new ConfigOptionInt(1));
+    print.apply(model, config);
+    CHECK_THAT(print.indx_layer_height_limit(), Catch::Matchers::WithinAbs(.14, 1e-6));
+    config.set_key_value("enable_support", new ConfigOptionBool(false));
+    print.apply(model, config);
+    CHECK_THAT(print.indx_layer_height_limit(), Catch::Matchers::WithinAbs(.56, 1e-6));
+
+    // Explicit feature assignments replace an unused default object filament.
+    model.objects.front()->config.set_key_value("extruder", new ConfigOptionInt(1));
+    for (const char* role : {"outer_wall_filament_id", "inner_wall_filament_id", "sparse_infill_filament_id",
+                             "internal_solid_filament_id", "top_surface_filament_id", "bottom_surface_filament_id"})
+        config.set_key_value(role, new ConfigOptionInt(2));
+    print.apply(model, config);
+    CHECK_THAT(print.indx_layer_height_limit(), Catch::Matchers::WithinAbs(.56, 1e-6));
+
+    config.set_key_value("filament_map", new ConfigOptionInts({2, 1}));
+    print.apply(model, config);
+    CHECK_THAT(print.indx_layer_height_limit(), Catch::Matchers::WithinAbs(.14, 1e-6));
+    config.set_key_value("machine_start_gcode", new ConfigOptionString("G28"));
+    print.apply(model, config);
+    CHECK(print.indx_layer_height_limit() == 0.);
+    config.set_key_value("machine_start_gcode", new ConfigOptionString("INDX_PRINT_START"));
+    Model empty;
+    print.apply(empty, config);
+    CHECK(print.indx_layer_height_limit() == 0.);
+}
