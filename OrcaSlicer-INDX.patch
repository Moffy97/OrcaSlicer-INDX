diff --git a/src/libslic3r/IndxChecks.hpp b/src/libslic3r/IndxChecks.hpp
new file mode 100644
index 00000000..85588637
--- /dev/null
+++ b/src/libslic3r/IndxChecks.hpp
@@ -0,0 +1,165 @@
+#pragma once
+#include <nlohmann/json.hpp>
+#include <cmath>
+#include <string>
+#include <vector>
+#include <algorithm>
+#include <stdexcept>
+#include <limits>
+
+namespace Slic3r { namespace Indx {
+using Json = nlohmann::json;
+// Accept only a complete, explicitly confirmed touchscreen declaration.
+// An offline or incomplete response must never shrink a saved printer profile.
+inline Json confirmed_tools(const Json& remote) {
+    if(!remote.value("online",false))return Json::array();
+    const auto hardware=remote.value("hardware",Json::object());
+    const double confirmed=hardware.value("confirmed_at",0.);
+    if(hardware.value("schema",0)!=2 || !std::isfinite(confirmed) || confirmed<=0)return Json::array();
+    const auto tools=hardware.value("tools",Json::array());
+    if(!tools.is_array() || tools.empty() || tools.size()>64)throw std::invalid_argument("invalid_tool_count");
+    Json normalized=Json::array();
+    for(size_t t=0;t<tools.size();++t) {
+        const auto& n=tools.at(t);
+        if(!n.is_object() || !n.contains("tool") || !n.at("tool").is_number_integer() || n.at("tool").get<int>()!=int(t) ||
+            !n.contains("diameter") || !n.at("diameter").is_number())throw std::invalid_argument("invalid_tool");
+        const double diameter=n.at("diameter").get<double>();
+        const auto type=n.value("type",std::string());
+        const double factor=n.value("cht_multiplier",1.3);
+        if(!std::isfinite(diameter) || diameter<.1 || diameter>2. || (type!="standard" && type!="cht") ||
+            !std::isfinite(factor) || factor<1. || factor>3.)throw std::invalid_argument("invalid_nozzle");
+        normalized.push_back({{"tool",t},{"diameter",diameter},{"type",type},{"cht_multiplier",factor}});
+    }
+    return normalized;
+}
+template<typename T> inline size_t combined_layers(const std::vector<T>& zs,size_t layer,double height) {
+    if(layer>=zs.size() || !std::isfinite(height) || height<=0)return 0;
+    for(size_t n=1;n<=layer+1;++n) {
+        const double before=n>layer?0.:zs[layer-n];
+        const double accumulated=zs[layer]-before;
+        if(std::abs(accumulated-height)<.0001)return n;
+        if(accumulated>height+.0001)break;
+    }
+    return 0;
+}
+
+// Orca's default map may point every slot at tool zero. With one identical
+// material/color slot per mounted tool, expose the complete tool set to proposals.
+inline std::vector<int> proposal_mapping(const Json& slots,size_t count,std::vector<int> maps,bool automatic=false) {
+    if(slots.size()<count || count==0)return maps;
+    const auto material=slots.front().value("material",std::string());
+    const auto color=slots.front().value("color",std::string());
+    if(material.empty() || color.empty())return maps;
+    for(const auto& slot:slots)
+        if(slot.value("material",std::string())!=material || slot.value("color",std::string())!=color)return maps;
+    if(!automatic && !maps.empty() && !std::all_of(maps.begin(),maps.end(),[](int tool){return tool==1;}))return maps;
+    maps.resize(slots.size(),1);
+    for(size_t t=0;t<count;++t)maps[t]=int(t)+1;
+    return maps;
+}
+
+// Passive INDX tools share the first physical feeder/heater's material capability.
+inline bool filament_printable(unsigned int mask,int tool,bool shared) {
+    if(tool<0 || tool>=64)return false;
+    const int physical=shared?0:tool;
+    return physical<int(std::numeric_limits<unsigned int>::digits) && ((mask>>physical)&1u)!=0;
+}
+
+inline Json propose_roles(Json candidates,const std::string& style,const Json& mounted=Json::array()) {
+    if(candidates.empty())throw std::invalid_argument("no_candidates");
+    if(style!="detail" && style!="balanced" && style!="speed")throw std::invalid_argument("invalid_style");
+    const auto material=candidates.front().value("material",std::string());
+    for(const auto& c:candidates)if(material.empty() || c.value("material",std::string())!=material)throw std::invalid_argument("mixed_materials");
+    std::stable_sort(candidates.begin(),candidates.end(),[](const Json& a,const Json& b){return a.at("diameter").template get<double>()<b.at("diameter").template get<double>();});
+    auto wall=candidates.front();
+    if(style=="detail" && wall.at("diameter").get<double>()>.4001)
+        throw std::invalid_argument("detail_no_fine_filament");
+    // A missing filament assignment must not silently hide a finer mounted nozzle.
+    if(style=="detail")for(const auto& tool:mounted)
+        if(tool.at("diameter").get<double>()+.0001<wall.at("diameter").get<double>())
+            throw std::invalid_argument("fine_tool_unassigned");
+    if(style=="speed")for(const auto& c:candidates)if(c.at("diameter").get<double>()<=.4001)wall=c;
+    if(style=="balanced")for(const auto& c:candidates)
+        if(c.at("diameter").get<double>()<=.6001 && c.at("diameter").get<double>()>wall.at("diameter").get<double>()+.0001)wall=c;
+    const auto infill=candidates.back();
+    return {{"wall",wall},{"solid",wall},{"infill",infill}};
+}
+
+// Shared protocol rules. Hardware is declared independently on the touchscreen;
+// a project catalog must never confirm what is physically mounted.
+inline Json calibration_states(const Json& record, const Json& cal, const Json& settings)
+{
+    Json result = Json::object();
+    for (const std::string kind : {"flow", "pa", "max_flow"}) {
+        std::string state = kind == "pa" ? "missing" : "estimated", reason = "no_test";
+        const auto value = cal.value(kind, Json());
+        const auto test = cal.value(kind + "_test", Json::object());
+        const auto context = test.value("context", Json::object());
+        const double low = kind == "flow" ? .5 : kind == "pa" ? 0. : .1;
+        const double high = kind == "flow" ? 1.5 : kind == "pa" ? 1. : 100.;
+        if (value.is_number() && std::isfinite(value.get<double>()) && value.get<double>() >= low && value.get<double>() <= high) {
+            state = "verified"; reason = "saved_test";
+            if (test.value("method", std::string()) != "visual-manual" || context.empty() || !test.value("updated", 0.)) {
+                state = "stale"; reason = "legacy_test";
+            } else if (cal.contains(kind + "_invalidated")) {
+                state = "stale"; reason = "manual_change";
+            } else {
+                for (const std::string field : {"temp", "bed", "type", "brand", "product"})
+                    if (context.value(field, Json()) != record.value(field, Json())) {
+                        state = "stale"; reason = "conditions_changed"; break;
+                    }
+                if (kind != "flow") {
+                    const auto flow = result["flow"]["state"] == "verified" ? cal.at("flow") : settings.value("flow", record.value("flow", Json(1.)));
+                    if (context.value("flow", Json()) != flow) { state = "stale"; reason = "flow_changed"; }
+                }
+            }
+        }
+        result[kind] = {{"state", state}, {"reason", reason}, {"value", value}, {"updated", test.value("updated", Json())}};
+    }
+    return result;
+}
+
+inline Json preflight(const Json& project, const Json& remote)
+{
+    Json issues = Json::array(), tools = Json::array();
+    auto issue = [&](const char* severity, const char* code, int tool = -1) {
+        issues.push_back({{"severity", severity}, {"code", code}, {"tool", tool}});
+    };
+    if (!remote.value("online", false)) issue("error", "offline");
+    else {
+        if (remote.value("state", std::string()) != "ready") issue("error", "not_ready");
+        if (remote.value("busy", false)) issue("error", "busy");
+        if (!remote.value("commissioned", false)) issue("error", "commissioning");
+    }
+    const auto hardware = remote.value("hardware", Json::object());
+    if (!hardware.value("confirmed_at", 0.)) issue("error", "hardware_unconfirmed");
+    const auto mounted = hardware.value("tools", Json::array());
+    const auto count=project.value("tool_count",4);
+    if(count<1 || count>64 || mounted.size()!=size_t(count) || remote.value("tool_count",0)!=count) issue("error","tool_count");
+    const auto assignments = remote.value("assignments", Json::object());
+    for (const auto& slot : project.at("slots")) {
+        const int tool = slot.at("tool").get<int>();
+        if (tool < 0 || tool >= count) { issue("error", "invalid_mapping", tool); continue; }
+        tools.push_back(tool);
+        if (mounted.size() != size_t(count) || mounted.at(tool).value("tool", -1) != tool) issue("error", "hardware_missing", tool);
+        else {
+            const auto& actual = mounted.at(tool);
+            if (std::abs(actual.value("diameter", 0.) - slot.at("diameter").get<double>()) > .0001) issue("error", "diameter", tool);
+            if (actual.value("type", std::string()) != slot.at("type").get<std::string>()) issue("error", "nozzle_type", tool);
+        }
+        const auto key = std::to_string(tool);
+        if (!assignments.contains(key)) { issue("error", "unassigned", tool); continue; }
+        const auto& assigned = assignments.at(key);
+        const auto uuid = slot.value("library_id", std::string());
+        if (uuid.empty() || uuid != assigned.value("library_id", std::string())) { issue("error", "filament", tool); continue; }
+        const auto& states = slot.at("calibrations");
+        for (const std::string kind : {"pa", "flow", "max_flow"})
+            if (states.at(kind).at("state") != "verified") issue("warning", ("calibration_" + kind).c_str(), tool);
+        if (!slot.value("values_match", false)) issue("error", "profile_values", tool);
+    }
+    if (project.at("slots").empty()) issue("error", "empty_plate");
+    bool blocked = false;
+    for (const auto& i : issues) if (i.at("severity") == "error") blocked = true;
+    return {{"schema", 1}, {"blocked", blocked}, {"issues", issues}, {"used_tools", tools}, {"slots", project.at("slots")}};
+}
+} }
