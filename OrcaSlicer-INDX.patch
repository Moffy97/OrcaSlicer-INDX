+    const auto* start=p.config.option<ConfigOptionString>("machine_start_gcode");
+    return start && start->value.find("INDX_PRINT_START")!=std::string::npos && sizes && sizes->values.size() >= 1 && sizes->values.size() <= MAXIMUM_EXTRUDER_NUMBER;
